{
  "contract": "MK10-PRO public release seal",
  "contract_version": 1,
  "package": "@kaaffilm/mk10-pro",
  "package_version": "1.0.3",
  "release": "v1.0.3",
  "scope": "public release discovery and release-gate binding only",
  "package_mutation": "forbidden",
  "feature_surface_mutation": "forbidden",
  "network_after_checkout": "forbidden",
  "requires_release_gate": true,
  "requires_airgap_digest_lock": true,
  "requires_airgap_negative_controls": true,
  "requires_airgap_bundle": true,
  "requires_offline_audit_lock": true,
  "public_entrypoints": [
    "README.md",
    "RELEASE_INDEX.json",
    "docs/RELEASE_INDEX.md",
    "PUBLIC_RELEASE_SEAL.json",
    "docs/PUBLIC_RELEASE_SEAL.md"
  ],
  "required_receipts": [
    "MK10_PRO_AIRGAP_AUDIT_RELEASE_GATE_RECEIPT.json",
    "MK10_PRO_AIRGAP_AUDIT_DIGEST_LOCK_RECEIPT.json",
    "MK10_PRO_AIRGAP_AUDIT_BUNDLE_RECEIPT.json"
  ],
  "required_negative_controls": [
    "missing release index is rejected",
    "missing public release seal is rejected",
    "version drift is rejected",
    "missing release gate is rejected",
    "missing workflow is rejected",
    "manifest omission is rejected"
  ],
  "required_files": [
    "README.md",
    "MANIFEST.in",
    "pyproject.toml",
    "packages/npm/package.json",
    "packages/npm/PACKAGE_SURFACES.json",
    "OFFLINE_AUDIT_LOCK.json",
    "AIRGAP_AUDIT_BUNDLE.json",
    "AIRGAP_AUDIT_NEGATIVE_CONTROLS.json",
    "AIRGAP_AUDIT_DIGEST_LOCK.json",
    "AIRGAP_AUDIT_RELEASE_GATE.json",
    "PUBLIC_RELEASE_SEAL.json",
    "RELEASE_INDEX.json",
    "docs/OFFLINE_AUDIT_LOCK.md",
    "docs/AIRGAP_AUDIT_BUNDLE.md",
    "docs/AIRGAP_AUDIT_NEGATIVE_CONTROLS.md",
    "docs/AIRGAP_AUDIT_DIGEST_LOCK.md",
    "docs/AIRGAP_AUDIT_RELEASE_GATE.md",
    "docs/PUBLIC_RELEASE_SEAL.md",
    "docs/RELEASE_INDEX.md",
    "scripts/offline-audit-lock.sh",
    "scripts/airgap-audit-bundle.sh",
    "scripts/airgap-audit-negative-controls.sh",
    "scripts/airgap-audit-digest-lock.sh",
    "scripts/airgap-audit-release-gate.sh",
    "scripts/public-release-seal.sh",
    ".github/workflows/offline-audit-lock.yml",
    ".github/workflows/airgap-audit-bundle.yml",
    ".github/workflows/airgap-audit-negative-controls.yml",
    ".github/workflows/airgap-audit-digest-lock.yml",
    ".github/workflows/airgap-audit-release-gate.yml",
    ".github/workflows/public-release-seal.yml",
    "tests/test_offline_audit_lock.py",
    "tests/test_airgap_audit_bundle.py",
    "tests/test_airgap_audit_negative_controls.py",
    "tests/test_airgap_audit_digest_lock.py",
    "tests/test_airgap_audit_release_gate.py",
    "tests/test_public_release_seal.py"
  ]
}
